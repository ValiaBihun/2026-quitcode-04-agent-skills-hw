index 0000000..677e4e8
--- /dev/null
+++ b/app/quotes/actions.ts
@@ -0,0 +1,74 @@
+"use server";
+
+import { randomUUID } from "node:crypto";
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+import { createCallbackToken, hashCallbackToken } from "@/lib/quotes";
+
+// n8n must answer the webhook right away ("Respond: Immediately"); the PDF itself
+// arrives later on the callback endpoint. We never wait for the 40–90 s run here.
+const WEBHOOK_ACK_TIMEOUT_MS = 10_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+async function appBaseUrl() {
+  if (process.env.APP_URL) return process.env.APP_URL.replace(/\/$/, "");
+  const requestHeaders = await headers();
+  const host = requestHeaders.get("host") ?? "localhost:3000";
+  const proto = requestHeaders.get("x-forwarded-proto") ?? "http";
+  return `${proto}://${host}`;
+}
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  // Unguessable id: /quotes/[id] is public and shows the requester's email.
+  const id = `q_${randomUUID()}`;
+  const callbackToken = createCallbackToken();
+  await db.insertQuote({ ...parsed.data, id, callbackTokenHash: hashCallbackToken(callbackToken) });
+
+  const webhookUrl = process.env.N8N_QUOTE_WEBHOOK_URL;
+  if (!webhookUrl) {
+    console.error("N8N_QUOTE_WEBHOOK_URL is not set; cannot start quote-request workflow");
+    await db.updateQuote(id, { status: "failed", error: "not_configured", callbackTokenHash: null });
+    redirect(`/quotes/${id}`);
+  }
+
+  try {
+    const response = await fetch(webhookUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: id,
+        ...parsed.data,
+        callbackUrl: `${await appBaseUrl()}/api/quotes/${id}/callback`,
+        callbackToken,
+      }),
+      signal: AbortSignal.timeout(WEBHOOK_ACK_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded with ${response.status}`);
+    await db.updateQuote(id, { status: "processing" });
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "TimeoutError") {
+      // n8n got the request but did not ack in time (webhook not set to respond
+      // immediately?). The run is most likely going, so keep waiting for the callback.
+      console.warn(`quote-request webhook did not ack quote ${id} in time`);
+      await db.updateQuote(id, { status: "processing" });
+    } else {
+      console.error(`Failed to start quote-request workflow for quote ${id}`, error);
+      await db.updateQuote(id, { status: "failed", error: "dispatch_failed", callbackTokenHash: null });
+    }
+  }
+
+  redirect(`/quotes/${id}`);
+}
