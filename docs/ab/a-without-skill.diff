+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+import type { Quote } from "./types";
+
+// The n8n workflow normally finishes in 40–90 s. Past this point the status page
+// stops polling and tells the visitor the quote is late.
+export const QUOTE_TIMEOUT_MS = 5 * 60 * 1000;
+
+export function createCallbackToken() {
+  return randomBytes(32).toString("base64url");
+}
+
+export function hashCallbackToken(token: string) {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+export function isValidCallbackToken(quote: Quote, token: string) {
+  if (!quote.callbackTokenHash) return false;
+  const expected = Buffer.from(quote.callbackTokenHash, "hex");
+  const actual = Buffer.from(hashCallbackToken(token), "hex");
+  return timingSafeEqual(expected, actual);
+}
+
+export function isQuotePending(quote: Pick<Quote, "status">) {
+  return quote.status === "queued" || quote.status === "processing";
+}
