@@ -0,0 +1,22 @@
+"use client";
+
+import { useEffect } from "react";
+import { useRouter } from "next/navigation";
+
+const POLL_INTERVAL_MS = 5000;
+
+// Re-renders the server page every few seconds while the quote is being prepared.
+// The server page stops rendering this component once the status is final.
+export function QuoteStatusPoller({ stopAt }: { stopAt: number }) {
+  const router = useRouter();
+
+  useEffect(() => {
+    const timer = setInterval(() => {
+      router.refresh();
+      if (Date.now() >= stopAt) clearInterval(timer);
+    }, POLL_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [router, stopAt]);
+
+  return null;
+}
