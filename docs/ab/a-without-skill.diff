+import Link from "next/link";
+import { notFound } from "next/navigation";
+import { QuoteStatusPoller } from "@/components/quote-status-poller";
+import { db } from "@/lib/db";
+import { BUDGET_OPTIONS } from "@/lib/quote-form";
+import { isQuotePending, QUOTE_TIMEOUT_MS } from "@/lib/quotes";
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+function isTimedOut(createdAt: string) {
+  return Date.now() - Date.parse(createdAt) > QUOTE_TIMEOUT_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;
+  const quote = await db.getQuote(id);
+  if (!quote) notFound();
+
+  const pending = isQuotePending(quote);
+  const timedOut = pending && isTimedOut(quote.createdAt);
+  const budgetLabel = BUDGET_OPTIONS.find((o) => o.value === String(quote.budget ?? ""))?.label;
+
+  return (
+    <div className="flex flex-1 flex-col">
+      <header className="border-b border-slate-200 bg-white">
+        <div className="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
+          <Link href="/" className="text-lg font-semibold tracking-tight">
+            Studio Nova
+          </Link>
+        </div>
+      </header>
+
+      <main className="mx-auto w-full max-w-3xl flex-1 space-y-6 px-6 py-12">
+        <h1 className="text-3xl font-semibold tracking-tight">Кошторис для {quote.company}</h1>
+
+        <section aria-live="polite" className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
+          {pending && !timedOut && (
+            <div className="flex items-start gap-3">
+              <span className="mt-1 h-3 w-3 shrink-0 animate-pulse rounded-full bg-indigo-500" aria-hidden />
+              <div className="space-y-1">
+                <p className="font-medium">
+                  {quote.status === "queued" ? "Запит поставлено в чергу…" : "Готуємо кошторис…"}
+                </p>
+                <p className="text-sm text-slate-600">
+                  Зазвичай це займає 40–90 секунд. Сторінка оновиться автоматично.
+                </p>
+              </div>
+            </div>
+          )}
+
+          {timedOut && (
+            <div className="space-y-1">
+              <p className="font-medium">Кошторис готується довше, ніж зазвичай.</p>
+              <p className="text-sm text-slate-600">
+                Оновіть сторінку пізніше або напишіть нам — менеджер надішле кошторис на вашу пошту.
+              </p>
+            </div>
+          )}
+
+          {quote.status === "ready" && quote.pdfUrl && (
+            <div className="space-y-3">
+              <p className="font-medium text-green-700">Кошторис готовий.</p>
+              <a
+                href={quote.pdfUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+                className="inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
+              >
+                Завантажити PDF
+              </a>
+            </div>
+          )}
+
+          {quote.status === "failed" && (
+            <div className="space-y-2">
+              <p className="font-medium text-red-700">Не вдалося підготувати кошторис автоматично.</p>
+              <p className="text-sm text-slate-600">
+                Ваш запит збережено — менеджер підготує кошторис вручну. Або{" "}
+                <Link href="/quotes/new" className="text-indigo-600 hover:underline">
+                  спробуйте ще раз
+                </Link>
+                .
+              </p>
+            </div>
+          )}
+        </section>
+
+        <dl className="grid gap-3 rounded-xl border border-slate-200 bg-white p-6 text-sm sm:grid-cols-[10rem_1fr]">
+          <dt className="text-slate-500">Надіслано</dt>
+          <dd>{dateTimeFormat.format(new Date(quote.createdAt))}</dd>
+          <dt className="text-slate-500">Бюджет</dt>
+          <dd>{budgetLabel ?? "—"}</dd>
+          <dt className="text-slate-500">Задача</dt>
+          <dd className="whitespace-pre-line">{quote.description}</dd>
+        </dl>
+      </main>
+
+      {pending && !timedOut && (
+        <QuoteStatusPoller stopAt={Date.parse(quote.createdAt) + QUOTE_TIMEOUT_MS} />
+      )}
+    </div>
+  );
+}
