+import { db } from "@/lib/db";
+import { isQuotePending, isValidCallbackToken } from "@/lib/quotes";
+
+// Called by the n8n `quote-request` workflow when the PDF is ready (or the run failed).
+//
+//   POST /api/quotes/:id/callback
+//   Authorization: Bearer <callbackToken from the webhook payload>
+//   { "status": "ready", "pdfUrl": "https://…/quote.pdf" }
+//   { "status": "failed", "error": "optional reason" }
+//
+// The token is single-use: it is cleared once the quote reaches a final status.
+
+type CallbackBody =
+  | { status: "ready"; pdfUrl: string }
+  | { status: "failed"; error: string | null };
+
+function parseBody(body: unknown): CallbackBody | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready") {
+    if (typeof pdfUrl !== "string" || !isSafePdfUrl(pdfUrl)) return null;
+    return { status, pdfUrl };
+  }
+  if (status === "failed") {
+    return { status, error: typeof error === "string" ? error.slice(0, 500) : null };
+  }
+  return null;
+}
+
+// The link is rendered on a public page, so allow only real web URLs
+// (plain http only for a local mock).
+function isSafePdfUrl(value: string) {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return false;
+  }
+  if (url.protocol === "https:") return true;
+  return url.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+}
+
+export async function POST(request: Request, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const token = request.headers.get("authorization")?.match(/^Bearer (.+)$/)?.[1];
+
+  const quote = token ? await db.getQuote(id) : null;
+  // Same answer for an unknown id and a wrong token, so the endpoint does not reveal which ids exist.
+  if (!quote || !token || !isValidCallbackToken(quote, token)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+  if (!isQuotePending(quote)) {
+    return Response.json({ error: "quote already completed" }, { status: 409 });
+  }
+
+  let body: CallbackBody | null;
+  try {
+    body = parseBody(await request.json());
+  } catch {
+    body = null;
+  }
+  if (!body) {
+    return Response.json(
+      { error: 'expected {"status":"ready","pdfUrl":"https://…"} or {"status":"failed","error":"…"}' },
+      { status: 400 },
+    );
+  }
+
+  if (body.status === "ready") {
+    await db.updateQuote(id, { status: "ready", pdfUrl: body.pdfUrl, callbackTokenHash: null });
+  } else {
+    console.error(`quote-request workflow failed for quote ${id}: ${body.error ?? "no reason given"}`);
+    await db.updateQuote(id, { status: "failed", error: body.error ?? "workflow_failed", callbackTokenHash: null });
+  }
+
+  return Response.json({ ok: true });
+}
